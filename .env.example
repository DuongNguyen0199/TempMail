# Web server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# SQLite nhúng, không cần cài database
DB_CONNECTION_STRING=file:./smailpro.db

# Generate strong random values before production:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_random_characters
# Exactly 32 bytes, encoded as 64 hexadecimal characters
ENCRYPTION_KEY=replace_with_64_hex_characters

# Optional
JWT_EXPIRES_IN=7d
SONJJ_BASE_URL=https://app.sonjj.com
API_TIMEOUT_MS=20000
TRUST_PROXY=false
# Keep false for direct http://IP:PORT; set true when serving through HTTPS.
COOKIE_SECURE=false
