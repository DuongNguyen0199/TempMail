generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DB_CONNECTION_STRING")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  username          String?
  passwordHash      String
  inboxTimestamp    BigInt             @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  apiConfigs        UserApiConfig[]
  gmailAccounts     GmailAccount[]
  inboxMessages     InboxMessage[]
  fetchLogs         FetchLog[]
  autoForwardConfig AutoForwardConfig?
  osMails           OsMail[]

  @@map("users")
}

model UserApiConfig {
  id              String   @id @default(cuid())
  userId          String
  provider        String   @default("sonjj_smailpro")
  apiKeyEncrypted String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("user_api_configs")
}

model AutoForwardConfig {
  id                 String   @id @default(cuid())
  userId             String   @unique
  enabled            Boolean  @default(true)
  targetEmail        String   @default("duongrbt@gmail.com")
  subjectsJson       String   @default("[\"OutSystems\"]")
  mailProvider       String   @default("smtp")
  fromEmail          String?
  apiSecretEncrypted String?
  smtpHost           String?  @default("smtp.gmail.com")
  smtpPort           Int?     @default(587)
  smtpSecure         Boolean? @default(false)
  smtpUser           String?
  smtpPassEncrypted  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auto_forward_configs")
}

model GmailAccount {
  id           String         @id @default(cuid())
  userId       String
  email        String
  type         String?
  password     String?
  timestamp    BigInt?
  rawJson      String?
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     InboxMessage[]

  @@unique([userId, email])
  @@index([userId, updatedAt])
  @@map("gmail_accounts")
}

model InboxMessage {
  id             String       @id @default(cuid())
  userId         String
  gmailAccountId String
  email          String
  mid            String
  sender         String?
  subject        String?
  snippet        String?
  receivedAt     DateTime?
  receivedTs     BigInt?
  isRead         Boolean      @default(false)
  isForwarded    Boolean      @default(false)
  forwardedAt    DateTime?
  body           String?
  rawInboxJson   String?
  rawMessageJson String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailAccount   GmailAccount @relation(fields: [gmailAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, email, mid])
  @@index([userId, email, receivedAt])
  @@index([gmailAccountId, receivedAt])
  @@map("inbox_messages")
}

model FetchLog {
  id            String   @id @default(cuid())
  userId        String
  action        String
  endpoint      String
  requestParams String?
  status        String
  errorMessage  String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("fetch_logs")
}

model OsMail {
  id             String   @id @default(cuid())
  userId         String
  gmailAccountId String?
  email          String
  mid            String
  sender         String?
  subject        String?
  snippet        String?
  body           String?
  receivedAt     DateTime?
  status         String   @default("PENDING")
  forwardedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email, mid])
  @@index([userId])
  @@index([userId, email])
  @@index([status])
  @@map("os_mails")
}

model PendingRegistration {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?
  passwordHash String
  otpCode      String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("pending_registrations")
}

